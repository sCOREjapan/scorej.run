{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true }
    },
    "simulator": {
      "distribution": "internal",
      "ios": { "simulator": true, "buildConfiguration": "Release" }
    },
    "preview": {
      "distribution": "internal",
      "ios": { "simulator": false }
    },
    "production": {
      "autoIncrement": true,
      "ios": { "buildConfiguration": "Release" },
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "amuletbaby.shop@gmail.com",
        "ascAppId": "6766394981",
        "appleTeamId": "4B5NK8DR67"
      }
    }
  }
}
