{
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "buildCommand": "npx expo export --platform web --clear",
  "outputDirectory": "dist",
  "framework": null,
  "crons": [
    { "path": "/api/daily-reminder?type=morning",  "schedule": "0 22 * * *" },
    { "path": "/api/daily-reminder?type=practice", "schedule": "0 8 * * *"  },
    { "path": "/api/daily-reminder?type=sleep",    "schedule": "0 11 * * *" }
  ]
}
