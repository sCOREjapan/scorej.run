      return fetch(url, {
        signal: AbortSignal.timeout(ms)
      });
    }
    // フォールバック：手動タイムアウト
    var controller = new AbortController();
    var id = setTimeout(() => controller.abort(), ms);
    return fetch(url, {
      signal: controller.signal
    }).finally(() => clearTimeout(id));
  }

  // ─────────────────────────────────────────
