0e0\uff08\u8155\u632f\u308a\u30fb\u63a5\u5730\u30fb\u9aa8\u76e4\u5b89\u5b9a\uff09\u3001\u30e9\u30b9\u30c8200m\u306e\u30b9\u30d1\u30fc\u30c8\u6642\u306e\u30d5\u30a9\u30fc\u30e0\u7dad\u6301\u80fd\u529b\u3092\u8a55\u4fa1\u3057\u3066\u304f\u3060\u3055\u3044\u3002"};case'1500m':return{role:'\u5143\u65e5\u672c\u4ee3\u8868\u306e1500m\u4e2d\u8ddd\u96e2\u30b3\u30fc\u30c1',focus:"1500m\u306e\u9078\u624b\u3067\u3059\u3002\u96c6\u56e3\u8d70\u4e2d\u306e\u7701\u30a8\u30cd\u30d5\u30a9\u30fc\u30e0\u3001\u30df\u30c3\u30c9\u30d5\u30c3\u30c8\u63a5\u5730\u306e\u6709\u7121\u3001\u9aa8\u76e4\u306e\u5b89\u5b9a\u6027\u3001\u80a9\u306e\u7121\u99c4\u306a\u529b\u307f\u3001\u30e9\u30b9\u30c81\u5468\u306e\u30b9\u30d1\u30fc\u30c8\u6642\u306e\u30d5\u30a9\u30fc\u30e0\u5909\u5316\u306b\u6ce8\u76ee\u3057\u3066\u304f\u3060\u3055\u3044\u3002"};case'3000m':case'5000m':case'10000m':return{role:'\u5143\u65e5\u672c\u4ee3\u8868\u306e\u9577\u8ddd\u96e2\u30b3\u30fc\u30c1',focus:`${n}\u306e\u9078\u624b\u3067\u3059\u3002\u7d4c\u6e08\u7684\u306a\u30e9\u30f3\u30cb\u30f3\u30b0\u30d5\u30a9\u30fc\u30e0\u304c\u6700\u91cd\u8981\u3067\u3059\u3002\u63a5\u5730\u30d1\u30bf\u30fc\u30f3\uff08\u30d2\u30fc\u30ebvs\u30df\u30c3\u30c9\u30d5\u30c3\u30c8\uff09\u3001\u9aa8\u76e4\u306e\u524d\u50be\u3068\u5b89\u5b9a\u6027\u3001\u80a9\u30fb\u8155\u306e\u7121\u99c4\u306a\u529b\u307f\u3001\u30d4\u30c3\u30c1\u3068\u6b69\u5e45\u306e\u30d0\u30e9\u30f3\u30b9\u3001\u524d\u50be\u59ff\u52e2\u306e\u89d2\u5ea6\u3092\u8a55\u4fa1\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u602a\u6211\u306b\u3064\u306a\u304c\u308b\u30d5\u30a9\u30fc\u30e0\u306e\u5d29\u308c\u3082\u6307\u6458\u3057\u3066\u304f\u3060\u3055\u3044\u3002`};case'3000mSC':return{role:'\u5143\u65e5\u672c\u4ee3\u8868\u306e\u969c\u5bb3\u7af6\u8d70\u30b3\u30fc\u30c1',focus:"3000mSC\u306e\u9078\u624b\u3067\u3059\u3002\u969c\u5bb3\u8d8a\u3048\u6280\u8853\uff08\u8e0f\u5207\u30bf\u30a4\u30df\u30f3\u30b0\u30fb\u30ea\u30fc\u30c9\u811a\u306e\u9ad8\u3055\u30fb\u30d0\u30ea\u30a2\u4e0a\u3067\u306e\u7740\