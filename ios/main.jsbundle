  }

  /** 痛み報告（部位名のみ・詳細テキストは送らない） */
  function trackBodyReport(partCount, parts) {
    trackEvent('body_report', {
      feature: 'pain',
      metadata: {
        part_count: partCount,
        parts
      }
    });
  }

  /** チーム参加 */
  function trackTeamJoin(role) {
    trackEvent('team_join', {
      feature: 'team',
      metadata: {
        role
      }
    });
  }

  /** 試合計画作成 */
  function trackCompetitionPlan(daysUntil) {
    trackEvent('competition_plan', {
      feature: 'competition',
      metadata: {
        days_until: daysUntil
      }
    });
  }
