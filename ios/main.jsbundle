  // lib/weather.ts — Open-Meteo API（無料・APIキー不要）天気取得 + キャッシュ管理
  // ルール：
  //   1. その日初めて開いたとき → APIを叩いて「今日の天気」として保存
  //   2. 昼12:00〜12:59 → もう1回だけ更新（午後の天気に合わせる）
  //   3. それ以外 → 保存済みキャッシュをそのまま表示

  var CACHE_KEY = 'weather_cache_v3';

  // デフォルト位置（東京）— 位置情報権限なし時のフォールバック
  var DEFAULT_LAT = 35.6895;
  var DEFAULT_LON = 139.6917;

  // ─────────────────────────────────────────
  // WMO weathercode → emoji + label
  // ─────────────────────────────────────────
  function decodeWeatherCode(code) {
    if (code === 0) return {
      icon: '☀️',
      label: '快晴'
    };
    if (code <= 3) return {
      icon: '🌤️',
      label: '晴れ〜曇り'
    };
    if (code <= 48) return {
      icon: '🌫️',
      label: '霧'
    };
    if (code <= 67) return {
      icon: '🌧️',
      label: '雨'
    };
    if (code <= 77) return {
      icon: '❄️',
      label: '雪'
    };
    if (code <= 82) return {
      icon: '🌦️',
      label: 'にわか雨'
    };
    if (code === 95) return {
      icon: '⛈️',
      label: '雷雨'
    };
    if (code >= 96) return {
      icon: '⛈️',
      label: '雷雨（雹）'
    };
    return {
      icon: '🌡️',
      label: '不明'
    };
  }

  // ─────────────────────────────────────────
  // スロット判定：1日1回だけ取得
  //   同じ日（YYYY-MM-DD）なら何時でもキャッシュを返す
  // ─────────────────────────────────────────
  function getDaySlot() {
    return new Date().toLocaleDateString('sv-SE'); // YYYY-MM-DD のみ
  }

